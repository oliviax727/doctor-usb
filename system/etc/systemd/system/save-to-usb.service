[Unit]
Description=Checkpoint RAM-mode root before shutdown
DefaultDependencies=no
After=local-fs.target ramroot-checkpoint.service
Before=shutdown.target reboot.target halt.target poweroff.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/local/bin/save-to-usb
StandardOutput=tty
StandardError=inherit
TTYPath=/dev/console
TimeoutStopSec=1800

[Install]
WantedBy=multi-user.target
